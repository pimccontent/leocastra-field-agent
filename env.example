# Studio ingest hostname or public IP (UDP).
# Use the name that reaches the ingest host, not an HTTPS-only website proxy.
LEOCASTRA_HOST=ingest.example.com

# Bonded UDP port shown in the studio contribution channel.
BONDED_PORT=10180

# Local SRT listen port for the encoder on this kit.
SRT_LISTEN_PORT=4001

UPLINKS_FILE=/var/lib/leocastra/uplinks
STATUS_PORT=8088
METRICS_BIND=127.0.0.1:9099

# Optional shortcut shown on this kit (not used for the bond).
# STUDIO_URL=https://studio.example.com/

# Contribution window in milliseconds. Match the studio channel.
LATENCY_MS=8000
